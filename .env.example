# Optional Cloud Backend Configuration
# The app operates 100% offline & standalone with local state if these are omitted.

# Supabase (Optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Bhashini / ULCA API (Optional - built-in Web Speech fallback is always active)
VITE_BHASHINI_API_KEY=your-bhashini-api-key
VITE_BHASHINI_USER_ID=your-bhashini-user-id
